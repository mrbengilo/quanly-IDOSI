BOOTSTRAP_TOKEN=replace-with-a-long-random-bootstrap-token
SESSION_TTL_SECONDS=43200
IDOSI_IMAGE=idosi-app:local
# Production requires the exact 40-character SHA; this also selects the external static volume.
IDOSI_RELEASE_SHA=unknown
# Optional: enables Google address suggestions. Manual address entry still works without it.
GOOGLE_MAPS_API_KEY=
