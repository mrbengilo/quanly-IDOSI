www.idosi.io.vn {
  redir https://idosi.io.vn{uri} permanent
}

idosi.io.vn {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=()"
    -Server
  }

  handle /api/* {
    reverse_proxy app:3000 {
      transport http {
        keepalive 30s
      }
    }
  }

  handle /.idosi-release-sha {
    respond 404
  }

  handle /assets/* {
    root * /srv/idosi
    header {
      Cache-Control "public, max-age=31536000, immutable"
      X-IDOSI-Static-Release "{$IDOSI_RELEASE_SHA}"
    }
    file_server
  }

  @shortLivedAssets path /favicon.ico /favicon.png /apple-touch-icon.png
  handle @shortLivedAssets {
    root * /srv/idosi
    header {
      Cache-Control "public, max-age=3600"
      X-IDOSI-Static-Release "{$IDOSI_RELEASE_SHA}"
    }
    file_server
  }

  handle {
    root * /srv/idosi
    header {
      Cache-Control "no-cache, no-store, must-revalidate"
      X-IDOSI-Static-Release "{$IDOSI_RELEASE_SHA}"
    }
    try_files {path} /index.html
    file_server
  }
}
