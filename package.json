{
  "name": "quan-ly-idosi",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/prepare-sites.mjs && node scripts/verify-bundle-budget.mjs",
    "bundle:verify": "node scripts/verify-bundle-budget.mjs",
    "bundle:verify:test": "node --test scripts/verify-bundle-budget.node-test.mjs",
    "sites:verify": "node scripts/verify-sites-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "vps:start": "node server/vps/server.mjs",
    "vps:bootstrap": "node server/vps/bootstrap.mjs",
    "lint": "eslint .",
    "pretest": "npm run bundle:verify:test && node --test scripts/audit-npm-bulk.node-test.mjs",
    "test": "vitest run --maxWorkers=1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react": "16.3.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "^26.1.0",
    "vitest": "4.1.10",
    "vite": "8.2.0"
  }
}
