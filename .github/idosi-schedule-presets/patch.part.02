.support-schedule-presets__configure {
  min-height: 34px;
  padding: 6px 10px;
  font-size: 11px;
}

.support-schedule-preset-config {
  display: grid;
  gap: 9px;
  padding: 12px;
  border: 1px solid var(--line, #d7e0da);
  border-radius: 14px;
  background: #f8fbf9;
}

.support-schedule-preset-config__header,
.support-schedule-preset-config__row {
  display: grid;
  grid-template-columns: minmax(130px, 1fr) minmax(120px, .75fr) minmax(120px, .75fr);
  align-items: center;
  gap: 10px;
}

.support-schedule-preset-config__header {
  color: var(--muted, #66756b);
  font-size: 12px;
  font-weight: 800;
}

.support-schedule-preset-config__row strong {
  color: var(--ink, #243029);
  font-size: 13px;
}

.support-schedule-preset-config__time-field {
  display: grid;
  gap: 5px;
}

.support-schedule-preset-config__time-field > span {
  display: none;
  color: var(--muted, #66756b);
  font-size: 11px;
  font-weight: 700;
}

.support-schedule-preset-config__actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding-top: 3px;
}

@media (max-width: 640px) {
  .support-schedule-presets__heading {
    align-items: flex-start;
  }

  .support-schedule-presets__configure {
    min-height: 30px;
    padding: 5px 8px;
    font-size: 10px;
  }

  .support-schedule-preset-config {
    padding: 10px;
  }

  .support-schedule-preset-config__header {
    display: none;
  }

  .support-schedule-preset-config__row {
    grid-template-columns: 1fr 1fr;
    gap: 7px;
  }

  .support-schedule-preset-config__row strong {
    grid-column: 1 / -1;
  }

  .support-schedule-preset-config__time-field > span {
    display: block;
  }

  .support-schedule-preset-config__actions {
    flex-wrap: wrap;
  }
}
'''


def transform_styles(text: str) -> str:
    return append_once(text, ".support-schedule-preset-config__header", CSS_BLOCK, "schedule preset styles")


PAGE_TEST_BLOCK = r'''  it('loads persisted quick periods and lets an authorized account save a shared configuration', async () => {
    const confirm = vi.spyOn(window, 'confirm').mockReturnValue(true)
    mocked.app = {
      ...mocked.app,
      supportSchedulePresets: [
        { id: 'morning', name: 'Ca sáng', start: '09:00', end: '12:15' },
        { id: 'afternoon', name: 'Ca chiều', start: '13:15', end: '17:45' },
        { id: 'office-hours', name: 'Giờ hành chính', start: '09:00', end: '17:45' },
      ],
    }
    render(<BusinessSupportSchedulePage />)

    fireEvent.click(screen.getByRole('button', { name: /Chọn nhanh Ca sáng/u }))
    expect(screen.getByLabelText(/^Giờ bắt đầu$/u).value).toBe('09:00')
    expect(screen.getByLabelText(/^Giờ kết thúc$/u).value).toBe('12:15')

    fireEvent.click(screen.getByRole('button', { name: 'CẤU HÌNH' }))
    fireEvent.change(screen.getByLabelText('Giờ bắt đầu Ca sáng'), { target: { value: '08:45' } })
    fireEvent.change(screen.getByLabelText('Giờ kết thúc Giờ hành chính'), { target: { value: '18:00' } })
    fireEvent.click(screen.getByRole('button', { name: 'LƯU CẤU HÌNH' }))

    await waitFor(() => expect(mocked.saveSupportSchedulePresets).toHaveBeenCalledWith([
      { id: 'morning', name: 'Ca sáng', start: '08:45', end: '12:15' },
      { id: 'afternoon', name: 'Ca chiều', start: '13:15', end: '17:45' },
      { id: 'office-hours', name: 'Giờ hành chính', start: '09:00', end: '18:00' },
    ]))
    expect(screen.getByLabelText(/^Giờ bắt đầu$/u).value).toBe('08:45')
    expect(confirm).toHaveBeenCalledWith('Bạn có chắc muốn thay đổi khung giờ mặc định? Cấu hình mới sẽ được sử dụng cho các lần tạo tiếp theo.')
    confirm.mockRestore()
  })

'''


def transform_page_test(text: str) -> str:
    text = replace_once(
        text,
        "  deleteBusinessSupportSchedule: vi.fn(),\n}))",
        "  deleteBusinessSupportSchedule: vi.fn(),\n  saveSupportSchedulePresets: vi.fn(),\n}))",
        "page test mocked function",
    )
    text = replace_once(
        text,
        "    mocked.deleteBusinessSupportSchedule.mockReset().mockResolvedValue({ ok: true })\n",
        "    mocked.deleteBusinessSupportSchedule.mockReset().mockResolvedValue({ ok: true })\n"
        "    mocked.saveSupportSchedulePresets.mockReset().mockResolvedValue({ ok: true })\n",
        "page test reset preset function",
    )
    text = replace_once(
        text,
        "      deleteBusinessSupportSchedule: mocked.deleteBusinessSupportSchedule,\n      settings:",
        "      deleteBusinessSupportSchedule: mocked.deleteBusinessSupportSchedule,\n"
        "      saveSupportSchedulePresets: mocked.saveSupportSchedulePresets,\n"
        "      supportSchedulePresets: [],\n"
        "      settings:",
        "page test app preset state",
    )
    text = text.replace("['Ca sáng', '08:00', '12:00']", "['Ca sáng', '08:30', '12:00']")
    text = text.replace("['Giờ hành chính', '08:00', '17:30']", "['Giờ hành chính', '08:30', '17:30']")
    text = replace_once(
        text,
        "      employeeId: 'VP-02', shiftName: 'Giờ hành chính', start: '08:00', end: '18:15',",
        "      employeeId: 'VP-02', shiftName: 'Giờ hành chính', start: '08:30', end: '18:15',",
        "page test configured default save expectation",
    )
    text = replace_once(
        text,
        "  it('renders the personal weekly schedule horizontally with avatar and empty days', () => {",
        PAGE_TEST_BLOCK + "  it('renders the personal weekly schedule horizontally with avatar and empty days', () => {",
        "page config test insertion",
    )
    return text


